{
  "expo": {
    "name": "Enntry",
    "slug": "Enntry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "Enntry",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.enntry.www"
    },
    "splash": {
      "image": "./assets/images/enntry-splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/enntry-splash-screen.png",
          "dark": {
            "image": "./assets/images/enntry-splash-screen.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "1557f95a-60eb-4bd3-acf1-84940827b82a"
      }
    },
    "android": {
      "package": "com.enntry.www",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "owner": "edwardobande36"
  }
}
