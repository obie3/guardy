{
  "expo": {
    "name": "guardy",
    "slug": "guardy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "guardy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-barcode-scanner",
      "expo-sqlite",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7bf78feb-e191-4ab7-bd39-a14ed09b72a5"
      }
    },
    "android": {
      "package": "com.edwardobande36.boltexponativewind"
    }
  }
}
